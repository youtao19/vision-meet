{
  "name": "career-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "knowledge:init": "tsx src/scripts/knowledge-init.ts",
    "knowledge:index:jobs": "tsx src/scripts/knowledge-index-jobs.ts",
    "knowledge:index:project-docs": "tsx src/scripts/knowledge-index-project-docs.ts",
    "knowledge:eval": "tsx src/scripts/knowledge-evaluate.ts",
    "llm:smoke": "tsx src/scripts/llm-smoke-test.ts",
    "moonshot:smoke": "tsx src/scripts/moonshot-smoke-test.ts",
    "moonshot:smoke:sdk": "tsx src/scripts/moonshot-openai-sdk-smoke.ts"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.64.0",
    "@sinclair/typebox": "^0.34.41",
    "@career/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "pg": "^8.16.3",
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
