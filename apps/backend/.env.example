APP_ENV=dev
PORT=8000
# REPORT_EXPORT_DIR=/absolute/path/to/exports/reports
# Agent 默认使用独立目录；若该目录缺少 auth/models，会优先从 ~/.pi/agent
# 自动兼容导入；若检测到 OpenClaw 的 ~/.openclaw/agents/main/agent/auth-profiles.json，
# 还会把其中兼容的 API key/OAuth 凭证转换导入到本项目的 auth.json。后续运行仍以独立目录为准。
# 若希望把当前 provider 的 Kimi/Moonshot key 直接落盘到独立 Agent 的 auth.json，可执行 `npm run agent:auth:kimi`。
# 岗位画像流水线只走 Agent，不会回退到其他默认模型；AGENT_MODEL 必须命中可用模型。
# AGENT_PI_DIR=/Users/your-name/.career-agent/pi-agent
# AGENT_SESSION_STORE_DIR=/Users/your-name/.career-agent/pi-agent/sessions
AGENT_MODEL=kimi-coding/k2p5
AGENT_THINKING_LEVEL=medium
# 简历生成接口超时（毫秒）。若你的 Pi Agent 首次响应较慢，可适当调大（例如 120000）。
AGENT_RESUME_TIMEOUT_MS=120000
MATCH_SCORING_VERSION=v1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=career_agent
PGUSER=career
PGPASSWORD=career_dev_password
PGVECTOR_DIM=32
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=career_dev_password
KNOWLEDGE_TOP_K=5
KNOWLEDGE_REINDEX_BATCH_SIZE=20
# Kimi Coding 配置（Pi SDK 内建 provider，当前项目默认使用这一条链路）。
# 这里只能填写示例占位值，严禁提交真实密钥；运行前请替换为真实可用的 key。
KIMI_API_KEY=your_kimi_coding_api_key
# KIMICODE_API_KEY=your_kimi_coding_api_key
KIMI_MODEL=kimi-coding/k2p5

# 若你仍需要兼容 Moonshot 开放平台 Kimi，可额外配置下列键。
# openclaw 风格：moonshot provider 只使用 MOONSHOT_API_KEY，对应模型如 moonshot/kimi-k2.5。
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_API_KEY=your_moonshot_api_key
# MOONSHOT_MODEL=moonshot/kimi-k2.5
