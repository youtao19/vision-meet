APP_ENV=dev
PORT=8000
# REPORT_EXPORT_DIR=/absolute/path/to/exports/reports
# Agent 默认使用独立目录；若该目录缺少 auth/models，会自动兼容导入
# ~/.openclaw/agents/main/agent 下同名文件，但后续运行仍以独立目录为准。
# AGENT_PI_DIR=/Users/your-name/.career-agent/pi-agent
# AGENT_SESSION_STORE_DIR=/Users/your-name/.career-agent/pi-agent/sessions
# AGENT_MODEL=openai/gpt-5.1
AGENT_THINKING_LEVEL=medium
MATCH_SCORING_VERSION=v1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=career_agent
PGUSER=career
PGPASSWORD=career_dev_password
PGVECTOR_DIM=32
KNOWLEDGE_TOP_K=5
KNOWLEDGE_REINDEX_BATCH_SIZE=20
# OpenClaw / Moonshot 风格配置，推荐直接使用这组键名。
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=sk-kimi-emr89817fFR6KoNUqQraI0qOohi7Re4KOTyXM5isyLDrMtdJXfiRWm7vtkKKj0eX
MOONSHOT_MODEL=moonshot/kimi-k2.5

# 也兼容通用 LLM_* 命名；若同时存在，优先使用 LLM_*。
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_API_KEY=你的_Kimi_API_Key
# LLM_MODEL=kimi-k2.5
LLM_TIMEOUT_MS=20000
# kimi-k2.5 默认按官方建议使用 1；如显式禁用 thinking，再改为 0.6。
LLM_TEMPERATURE=1
