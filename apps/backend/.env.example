APP_ENV=dev
PORT=8000
# REPORT_EXPORT_DIR=/absolute/path/to/exports/reports
# 岗位漫画/有声绘本输出目录；默认落在后端本地 storage/job-picture-books。
# 兼容旧变量 JOB_COMIC_OUTPUT_DIR，但新配置请使用 JOB_PICTURE_BOOK_OUTPUT_DIR。
# JOB_PICTURE_BOOK_OUTPUT_DIR=/absolute/path/to/storage/job-picture-books
# baoyu-imagine 脚本路径；默认读取 ~/.codex/skills/baoyu-imagine/scripts/main.ts。
# BAOYU_IMAGINE_SCRIPT=/Users/your-name/.codex/skills/baoyu-imagine/scripts/main.ts
# TTS 引擎类型；say 为 macOS 本地语音，volcengine 为火山引擎语音合成。
TTS_ENGINE=say
# TTS 音色；say 默认 Tingting，volcengine 默认 zh_female_shuangkuaisisi_moon_bigtts。
# TTS_VOICE=Tingting
# 火山引擎语音合成配置；使用 TTS_ENGINE=volcengine 时必须配置。
# VOLCENGINE_TTS_APP_ID=your_volcengine_app_id
# VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_access_token
# VOLCENGINE_TTS_CLUSTER=volcano_tts
# Agent 默认使用独立目录；若该目录缺少 auth/models，会优先从 ~/.pi/agent
# 自动兼容导入；若检测到 OpenClaw 的 ~/.openclaw/agents/main/agent/auth-profiles.json，
# 还会把其中兼容的 API key/OAuth 凭证转换导入到本项目的 auth.json。后续运行仍以独立目录为准。
# 通用登录入口：`npm run agent:auth -- login <provider>`。
# 也可用 `npm run agent:auth -- list` 查看 Pi 支持的登录方式，`npm run agent:auth -- use <provider/model>` 快速切换模型。
# 模型选择写入项目 Agent 目录，不通过 .env 选择登录方式或模型。
# AGENT_PI_DIR=/Users/your-name/.career-agent/pi-agent
# AGENT_SESSION_STORE_DIR=/Users/your-name/.career-agent/pi-agent/sessions
AGENT_THINKING_LEVEL=medium
# 职业报告只需结构化写作，默认用 minimal，避免报告生成等待过久。
AGENT_REPORT_THINKING_LEVEL=minimal
# 简历生成接口超时（毫秒）。完整 HTML 简历生成较慢，建议至少 180 秒。
AGENT_RESUME_TIMEOUT_MS=180000
# 职业报告生成接口超时（毫秒）。报告正文走 Agent 生成，建议至少 180 秒。
AGENT_REPORT_TIMEOUT_MS=180000
MATCH_SCORING_VERSION=v1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=career_agent
PGUSER=career
PGPASSWORD=career_dev_password
PGVECTOR_DIM=32
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=career_dev_password
KNOWLEDGE_TOP_K=5
KNOWLEDGE_REINDEX_BATCH_SIZE=20
# Kimi Coding 配置（Pi SDK 内建 provider，当前项目默认使用这一条链路）。
# 这里只能填写示例占位值，严禁提交真实密钥；运行前请替换为真实可用的 key。
KIMI_API_KEY=your_kimi_coding_api_key
# KIMICODE_API_KEY=your_kimi_coding_api_key

# 若你仍需要兼容 Moonshot 开放平台 Kimi，可额外配置下列键。
# openclaw 风格：moonshot provider 只使用 MOONSHOT_API_KEY。
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_API_KEY=your_moonshot_api_key
