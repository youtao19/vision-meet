APP_ENV=dev
PORT=8000
# DATA_STORE_PATH=/absolute/path/to/data.json
# PROFILE_STORE_PATH=/absolute/path/to/student-profiles.json
# MATCH_STORE_PATH=/absolute/path/to/matches.json
# REPORT_STORE_PATH=/absolute/path/to/reports.json
# REPORT_EXPORT_DIR=/absolute/path/to/exports/reports
# REPORT_EXPORT_STORE_PATH=/absolute/path/to/report-exports.json
# AGENT_RUN_STORE_PATH=/absolute/path/to/agent-runs.json
MATCH_SCORING_VERSION=v1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=career_agent
PGUSER=career
PGPASSWORD=career_dev_password
PGVECTOR_DIM=32
KNOWLEDGE_TOP_K=5
KNOWLEDGE_REINDEX_BATCH_SIZE=20
# OpenClaw / Moonshot 风格配置，推荐直接使用这组键名。
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=你的_Moonshot_API_Key
MOONSHOT_MODEL=moonshot/kimi-k2.5

# 也兼容通用 LLM_* 命名；若同时存在，优先使用 LLM_*。
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_API_KEY=你的_Kimi_API_Key
# LLM_MODEL=kimi-k2.5
LLM_TIMEOUT_MS=20000
# kimi-k2.5 默认按官方建议使用 1；如显式禁用 thinking，再改为 0.6。
LLM_TEMPERATURE=1
