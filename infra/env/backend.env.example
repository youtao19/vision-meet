APP_ENV=docker
PORT=8000

REPORT_EXPORT_DIR=/app/apps/backend/storage/exports/reports
JOB_PICTURE_BOOK_OUTPUT_DIR=/app/apps/backend/storage/job-picture-books

PGHOST=postgres
PGPORT=5432
PGDATABASE=career_agent
PGUSER=career
PGPASSWORD=career_dev_password
PGVECTOR_DIM=32

NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=career_dev_password

KNOWLEDGE_TOP_K=5
KNOWLEDGE_REINDEX_BATCH_SIZE=20
MATCH_SCORING_VERSION=v1

AGENT_PI_DIR=/app/.career-agent/pi-agent
AGENT_SESSION_STORE_DIR=/app/.career-agent/pi-agent/sessions
AGENT_THINKING_LEVEL=medium
AGENT_REPORT_THINKING_LEVEL=minimal
AGENT_RESUME_TIMEOUT_MS=180000
AGENT_REPORT_TIMEOUT_MS=180000

TTS_ENGINE=volcengine
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts
VOLCENGINE_TTS_CLUSTER=volcano_tts

# 完整 AI 模式：复制本文件为 infra/env/backend.env 后填写真实值。
# KIMI_API_KEY=your_kimi_coding_api_key
# KIMICODE_API_KEY=your_kimi_coding_api_key
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_API_KEY=your_moonshot_api_key

# 火山 TTS：使用岗位有声绘本功能前必须填写真实值。
# VOLCENGINE_TTS_APP_ID=your_volcengine_app_id
# VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_access_token
